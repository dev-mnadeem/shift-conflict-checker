{
  "name": "bravocare-shift-overlap",
  "version": "1.0.0",
  "private": true,
  "description": "Shift overlap and staffing API for the Bravocare exercise",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "NODE_ENV=test node --test \"tests/**/*.test.js\"",
    "test:db": "DATABASE_URL=\"$TEST_DATABASE_URL\" prisma migrate deploy && NODE_ENV=test node --test \"tests/db/*.test.js\"",
    "test:client": "npm --prefix client test -- --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2"
  }
}
